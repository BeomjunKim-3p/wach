@startuml
title B-Type
autonumber
participant controller         as ct
participant alu                as al
participant registerfile       as rf
participant "program counter"  as pc
participant databus            as db
participant dataline           as dl
participant addrline           as adl
participant mem                as me

group fetch1
  pc -> adl : fetch1
  adl --> me
  me --> dl
  dl -> db
  db -> ct : opcode && rs2
end

group decode1
  ct --> ct : decode
  note right: 여기서부터 컨트롤러는 현재 BType 실행중임을 알고 OF를 미리 진행할수 있다
  ct -> ct : rs2저장
  ct --> rf : rs2요청
  rf -> db : [rs2]
  db -> al : b
end

group fetch2
  ct --> pc : next
  pc -> adl : fetch2
  adl --> me
  me --> dl
  dl -> db
  db -> ct : rs1 && immi[3:0]
end

group decode3
  ct --> ct : decode
  ct -> ct : rs1 저장
  ct -> ct : immi[3:0] 저장
  group OF
    ct --> rf : rs1요청
    rf -> db : [rs1]
    db -> al : a
  end
  note right: 현재 BType 임을 알고 OF 미리 진행
end

group fetch3
  ct --> pc : next
  pc -> adl : fetch3
  adl --> me
  me --> dl
  dl -> db
  db -> ct : funct && immi[7:4]
end

group decode3
  ct --> ct : decode
  ct -> ct : funct저장
end
group execute
  ct --> al : ALU_Inst = subtract
  al -> ct : NZCV플래그
  ct -> ct : funct와 플래그 비교해 조건 검사
  alt 조건만족
    ct --> pc : Adder A = counter
    ct -> pc : Immigen -> Adder B
    ct --> pc : PC_NEXT
  else 조건불만족
    ct --> pc : next
    note right: 다음 명령어 실행 위해 준비
  end
end

group Interrupt
end
note right: 별도의 WA824IInterruptState파일에서 기술
@enduml